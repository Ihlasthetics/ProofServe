{
  "name": "proofserve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:shared": "npm run build --workspace=@proofserve/shared",
    "pretypecheck": "npm run prepare:shared",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "npm run prepare:shared",
    "test": "npm run test --workspaces",
    "prebuild": "npm run prepare:shared",
    "build": "npm run build --workspaces",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
