# Never put real secrets or private keys in this file.
# Y06 deployment instructions and per-process variable inventory:
# docs/deployment.md. Inject variables separately into each process.
# Web server only: both variables use the same API origin, without a path.
# In deployment use the public HTTPS origin. Never expose either as NEXT_PUBLIC_*.
REGISTRY_API_ORIGIN=https://api.example.test
PROOFSERVE_API_ORIGIN=https://api.example.test

# Y02 registry API. Supply these through the server environment.
PORT=3001
HOST=0.0.0.0
# FICTIONAL example only: replace with the approved team-controlled endpoint.
# This example is not suitable as a deployed production endpoint.
# If absent or invalid, service registration fails with ENDPOINT_NOT_ALLOWED.
TRIAGE_SERVICE_ENDPOINT=https://triage.example.test/v1/triage
# FICTIONAL placeholders for Y05. DATABASE_URL must name the approved shared
# PostgreSQL database; the API never returns or logs this value.
DATABASE_URL=postgresql://proofserve:fictional-password@db.example.test:5432/proofserve
AGENT_REGISTRY_BASE_URL=https://api.example.test
# Server-to-server secret only. Never embed this token in browser code.
AGENT_RUN_API_TOKEN=fictional-agent-run-token-change-me-0000000000000000
# FICTIONAL payer identity placeholders required by the Y05 API at startup.
HEDERA_PAYER_ACCOUNT_ID=0.0.654321
HEDERA_PAYER_PRIVATE_KEY=replace-with-a-testnet-payer-private-key

# Y04 World IDKit 4.x Selfie Check. All identifiers below are fictional.
# Sandbox is a distinct IDKit destination; staging is the browser simulator.
# Use production only with separately configured production World resources.
WORLD_APP_ID=app_sandbox_00000000000000000000000000000000
WORLD_RP_ID=rp_00000000000000000000000000000000
# Server-only placeholder. Replace with the RP's 32-byte hex signing key.
WORLD_RP_SIGNING_KEY=replace-with-server-only-world-rp-signing-key
WORLD_ACTION=proofserve-provider-verification
WORLD_ENVIRONMENT=sandbox
WORLD_VERIFICATION_FRESHNESS_SECONDS=86400

# Y03 protected triage service. All account IDs and credentials below are
# fictional placeholders; inject real values through the deployment environment.
TRIAGE_SERVICE_HOST=0.0.0.0
TRIAGE_SERVICE_PORT=3002
X402_RECEIVER_ACCOUNT_ID=0.0.123456
X402_PRICE_TINYBAR=1000000
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
TRIAGE_MODEL_PROVIDER=gemini
TRIAGE_MODEL=gemini-3.7-flash
GEMINI_API_KEY=fictional-placeholder

# Guarded real-payment smoke test. Do not enable in normal tests or CI.
RUN_REAL_PAYMENT_SMOKE=false
TRIAGE_SMOKE_URL=https://triage.example.test/v1/triage
